# Configuração única de todos os serviços. Copie para .env e rode: docker compose up -d --build
# (variante com hot reload no frontend: docker compose -f docker-compose.dev.yml up -d --build)

# ---- Portas no host ----
API_PORT=3000
AI_PORT=8000
FRONTEND_PORT=5173
DB_PORT=5432

# ---- Postgres ----
POSTGRES_USER=banking
POSTGRES_PASSWORD=banking

# ---- API do banco (Backend 1) ----
# Valores longos e aleatórios: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=
# Chave do provedor de identidade de TESTE. Também vai para o bundle do frontend (é pública na demo).
AUTH_SERVICE_KEY=
AUTH_SESSION_TTL_SECONDS=900
# Clientes que podem receber sessão de teste. Sem a variável, o compose usa os 5 da demo; vazia libera todos.
# AUTH_ALLOWED_CUSTOMERS=CLI-25NDK326VNE4,CLI-EF70WD91TBJQ,CLI-QITAGXCUR83U,CLI-7T6B34S2O9UL,CLI-CSV0VF8IA55L
API_LOG_LEVEL=info

# ---- Assistente de IA (Backend 2) ----
# Modelos: chaves de ai-backend/config/models.yaml.
# Dev via 9router (OpenAI-compatível): gemini-3.8-flash / gemini-3.1-pro-low.
# Para um 9router rodando nesta máquina use http://host.docker.internal:20128/v1.
OPENAI_COMPAT_BASE_URL=http://host.docker.internal:20128/v1
OPENAI_COMPAT_API_KEY=
AGENT_MODEL=gemini-3.8-flash
JUDGE_MODEL=gemini-3.1-pro-low
# Só se usar os modelos claude-* do models.yaml (provider anthropic).
ANTHROPIC_API_KEY=
TRACE_RETENTION_DAYS=30
AI_LOG_LEVEL=INFO
