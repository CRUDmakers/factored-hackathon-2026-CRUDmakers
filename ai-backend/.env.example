# Copy to .env and fill in. Never commit real values.

# Model providers
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Keys in config/models.yaml
AGENT_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-sonnet-5

# Bank: "fake" (offline fixture) or "http" (Node mock bank, which also checks sessions)
BANK_MODE=fake
BANK_BASE_URL=http://localhost:3000
BANK_FIXTURE_DIR=eval/fixtures/data

# Frontend origins allowed to call the API from the browser (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Only for the eval runner and `pytest -m node` against a live Node: issues test sessions.
# The service itself never reads it.
EVAL_SERVICE_KEY=

# Checkpointer + traces
DB_URL=sqlite:///./ai_backend.db
TRACE_RETENTION_DAYS=30
LOG_LEVEL=INFO
