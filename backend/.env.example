# Copie para .env e preencha. O .env é lido pelos scripts do npm (start, dev, etl, db:reset) e pelo CLI do Prisma.
# Variáveis já definidas no ambiente têm prioridade sobre o .env.

# ---- Banco ----
# Postgres. Fora da rede do provedor, o Render exige SSL: acrescente ?sslmode=require.
DATABASE_URL=postgresql://banking:banking@localhost:5432/banking

# ---- API ----
# Obrigatórios em produção (NODE_ENV=production): valores longos e aleatórios, ex.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=
AUTH_SERVICE_KEY=
AUTH_SESSION_TTL_SECONDS=900
# Clientes que podem receber sessão de teste (vírgulas). Vazio = todos.
AUTH_ALLOWED_CUSTOMERS=
PORT=3000
HOST=0.0.0.0
SCHEDULER_INTERVAL_MS=60000
LOG_LEVEL=info

# ---- ETL (etl, db:reset) ----
# Pasta com os CSVs do datathon.
DATA_DIR=../data
