{
  "name": "banking-cs-backend",
  "version": "1.0.0",
  "description": "Backend 1 do Banco LATAM: leitura de dados e simulação de operações bancárias",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsx --env-file-if-exists=.env watch src/main.ts",
    "migrate": "prisma migrate deploy",
    "studio": "prisma studio --port 5555",
    "etl": "node --env-file-if-exists=.env dist/etl/cli.js",
    "etl:dev": "tsx --env-file-if-exists=.env src/etl/cli.ts",
    "db:reset": "prisma migrate deploy && tsx --env-file-if-exists=.env src/etl/cli.ts --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "fast-jwt": "^6.3.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "prisma": "^7.10.0",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@vitest/coverage-v8": "^5.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
