# URL da API do Backend 1 (vista pelo navegador)
VITE_API_URL=http://localhost:3000
# Chave do provedor de identidade de TESTE. Só para a demo: qualquer valor VITE_* vai para o bundle público.
VITE_SERVICE_KEY=dev-service-key

# true => Usa API simulada para desenvolvimento.
VITE_USE_MOCK_API=false
